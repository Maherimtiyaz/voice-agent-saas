# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
#
#   cp .env.example .env
#
# Never commit `.env`. Generate every secret with a CSPRNG
# (`openssl rand -base64 32`) and use a different value per environment.
# ---------------------------------------------------------------------------

# Force a non-production runtime (production is set by the host).
NODE_ENV=development

# --- Database ---------------------------------------------------------------

# Postgres connection string used by Drizzle, the app, and the media-streams
# service. Local dev example:
#   postgres://postgres:postgres@localhost:5432/voice_agent_saas
#
# In production use the PROVIDER'S POOLED connection string (Neon "Pooled
# connection", Supabase pooler on port 6543, RDS Proxy, PgBouncer). Every
# serverless instance opens its own pool, so a direct connection string will
# exhaust the database's connection limit under load.
DATABASE_URL=

# TLS for the database connection. If unset, TLS is required for every
# non-local host and disabled for localhost. Set `disable` only for a trusted
# local/private network; production refuses to start with TLS disabled against
# a remote host. `verify-full` additionally checks the server certificate
# chain and hostname (requires a CA bundle for self-signed providers).
# One of: require | verify-full | prefer | disable
# DATABASE_SSL=

# Maximum connections per process. Remote/serverless default 3; local default
# 10. Keep this small and let the provider's pooler multiplex.
# DATABASE_POOL_MAX=3

# Set to `false` when the pooler runs in transaction mode (Supabase port
# 6543, PgBouncer transaction pooling) — prepared statements are not safe
# across pooled transactions.
# DATABASE_PREPARE=true

# --- Sessions ---------------------------------------------------------------

# Secret used to sign session JWTs and OAuth state. Generate with:
#   openssl rand -base64 32
# Must be at least 32 characters in production. Rotating it signs every
# existing session out.
SESSION_SECRET=

# --- Public origin ----------------------------------------------------------

# The exact public HTTPS origin this app is deployed at (no trailing slash),
# e.g. https://your-app.example.com. Used for Twilio signature verification,
# OAuth redirects, invitation links, and password-reset links. For local
# development this is your ngrok/tunnel URL.
APP_URL=

# --- Phase 1: voice (Twilio + Vapi) ----------------------------------------

# From the Twilio Console (console.twilio.com) -> Account -> API keys &
# tokens. TWILIO_AUTH_TOKEN verifies the X-Twilio-Signature header on inbound
# call webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# From the Vapi dashboard (dashboard.vapi.ai) -> API Keys. Used server-side
# to create/update assistants and to place the phone-call-bypass request that
# bridges an inbound Twilio call to Vapi.
VAPI_PRIVATE_API_KEY=

# A secret YOU choose. Configure it as an "X-Vapi-Secret" credential on your
# Vapi Server URL with this same value, so Vapi sends it back in the
# X-Vapi-Secret header on every webhook request.
VAPI_WEBHOOK_SECRET=

# OpenAI Realtime calls and optional AI-generated transfer briefings.
OPENAI_API_KEY=
OPENAI_HANDOFF_SUMMARY_MODEL=gpt-4o-mini
# Optional override for the Realtime model used by the media-streams service.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Custom Media Streams service (not deployable on Vercel functions).
# MEDIA_STREAMS_URL must be a public wss:// origin reachable by Twilio.
MEDIA_STREAMS_URL=
# At least 32 characters; shared by Next.js and the Media Streams service.
MEDIA_STREAMS_SECRET=
MEDIA_STREAMS_HOST=0.0.0.0
MEDIA_STREAMS_PORT=8787

# --- Calendar (Google) ------------------------------------------------------

# Google Cloud OAuth 2.0 Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key, base64 or hex, used to encrypt stored refresh tokens with
# AES-256-GCM. Generate with: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- CRM (HubSpot) ----------------------------------------------------------

# HubSpot public app client.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# 32-byte key, base64 or hex, used to encrypt stored refresh tokens.
CRM_TOKEN_ENCRYPTION_KEY=

# --- Transactional email ----------------------------------------------------

# Used to deliver workspace invitations, password-reset links, and lead
# notifications. The app speaks the `POST {EMAIL_API_URL}/emails` JSON API
# shape (Resend and several other providers implement it).
#
# When EMAIL_API_KEY and EMAIL_FROM are BOTH set, invitation and password
# reset emails are sent automatically. When they are not set, invites fall
# back to a copyable link and password reset reports that email is
# unavailable. Nothing is silently dropped either way.
EMAIL_API_KEY=
EMAIL_FROM=
# Optional. Defaults to https://api.resend.com.
EMAIL_API_URL=

# Where new landing-page demo requests are announced. Optional; requires the
# email provider above.
DEMO_NOTIFICATION_EMAIL=

# --- Schedulers -------------------------------------------------------------

# Shared secrets for the internal cron endpoints. Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET`; set CRON_SECRET plus the two
# endpoint-specific variables to the same value. If an endpoint's variable is
# unset that endpoint returns 404.
CRON_SECRET=
EMAIL_CRON_SECRET=
CAMPAIGN_CRON_SECRET=

# --- Platform admin ---------------------------------------------------------

# HTTP Basic auth for the landing-page lead inbox at
# /api/admin/demo-requests. These leads are global (not part of any
# workspace), so they cannot use the workspace membership model.
#
# The password must be at least 24 characters or the inbox stays disabled
# (404). Generate it with: openssl rand -base64 32
#
# ADMIN_ALLOWED_IPS is an optional comma-separated allowlist of IPv4/IPv6
# addresses or IPv4 CIDR ranges. When set, requests from any other address
# get a 404 before credentials are checked.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
